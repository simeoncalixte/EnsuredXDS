    {
      "id": "xds.requested-coverage",
      "version": 1,
      "export": "@ensured/xds/components/RequestedCoverageEditor",
      "kind": "composite",
      "fieldTypes": [],
      "binding": "coverages",
      "scope": "subject",
      "description": "Requested coverage cards with editable titles, requested selection, independent limit and deductible currencies, additional terms, add/remove and reorder. Owns the entire subject coverages collection; do not generate duplicate coverage fields.",
      "propsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "allowRename": {
            "type": "boolean"
          },
          "allowReorder": {
            "type": "boolean"
          },
          "termsMaxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          }
        }
      },
      "dataSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "coverageId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "selected": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "limit": {
              "type": ["number", "string", "object", "null"],
              "minimum": 0
            },
            "deductible": {
              "type": ["number", "string", "object", "null"],
              "minimum": 0
            },
            "currencyCode": {
              "type": "string",
              "pattern": "^([A-Z]{3})?$"
            },
            "limitCurrencyCode": {
              "type": "string",
              "pattern": "^([A-Z]{3})?$"
            },
            "deductibleCurrencyCode": {
              "type": "string",
              "pattern": "^([A-Z]{3})?$"
            },
            "terms": {
              "type": "string"
            }
          }
        }
      }
    },
