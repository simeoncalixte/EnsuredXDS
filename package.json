{
  "name": "@simeoncalixte/ensured-xds",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared React components and themes for Ensured applications",
  "files": [
    "dist",
    "README.md",
    "schema"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./colors.css": "./dist/colors.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "import": "./dist/colors.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./schema/component-registry.json": "./schema/component-registry.json",
    "./schema/component-manifest.generated.json": "./schema/component-manifest.generated.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "npm run build && node --test test/package.test.mjs test/component-manifest.test.mjs",
    "sync:schema-registry": "node scripts/sync-schema-registry.mjs",
    "check:schema-registry": "node scripts/sync-schema-registry.mjs --check",
    "generate:component-manifest": "node scripts/generate-component-manifest.mjs",
    "test:component-manifest": "node --test test/component-manifest.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.0.0",
    "react-router": "^7.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "^8.6.18",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.3",
    "storybook-addon-remix-react-router": "^4.0.1",
    "typescript": "^5.1.6",
    "vite": "^5.0.0",
    "@types/node": "^25.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.0.0",
    "react-router": "^7.0.0",
    "recharts": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simeoncalixte/EnsuredXDS.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  }
}
